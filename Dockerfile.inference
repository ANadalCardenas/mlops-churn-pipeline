# Inference image: loads churn-model@Production from the MLflow Model Registry,
# predicts on the JSON passed via --input, and appends the result to a CSV.
# Mount a host directory at /app/predictions to persist the CSV across runs.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/

ENTRYPOINT ["python", "-m", "src.inference.predict"]
